<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="../stylesheets/app.css">
    <title><%= title %></title>
</head>
<body>
<div class="bar">
    <img id="left" src="/images/flags/flag-4x3.png" alt="Flag of the Crushian Empire">
    <h1 id="middle"><%= title %></h1>
    <a id="right" href="/logout">Log Out</a>
</div>
<div class="container">
    <div class="screen">
        <h1>Hello <%= username %>!</h1>
        <ul>
            <li>Welcome to the Crushian Empire Trade Deals page.</li>
            <li>You can request a trade deal here.</li>
            <li>We'll get a message in our Discord channel</li>
            <li>If we like it we'll invite you to a thread to discuss it.</li>
            <li>If you visit this page after you've paid your taxes, you won't be able to pay it again.</li>
        </ul>
    </div>
</div>
<div class="container">
    <div class="screen">
        <h1>Trade Deal Form</h1>
        <form action="../post-trade" method="POST">
            <input type="text" name="Name" id="Name" placeholder="Enter Name">
            <br>
            <input type="submit" value="Submit">
        </form>
    </div>
</div>
</body>
</html>