<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="../stylesheets/app.css">
    <title><%= title %></title>
</head>
<body>
<div class="bar">
    <img id="left" src="/images/flags/flag-4x3.png" alt="Flag of the Crushian Empire">
    <h1 id="middle"><%= title %></h1>
    <a id="right" href="/app">Back to App Dashboard</a>
</div>
<div class="container">
    <div class="screen">
        <h1>Hello <%= username %>!</h1>
        <p>You've already paid your taxes! Good job.</p>
        <a class="button" href="/app">Go back to the app dashboard</a>
    </div>
</div>
</body>
</html>