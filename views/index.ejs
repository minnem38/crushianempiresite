<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
      <script type="text/javascript" src="/javascripts/index.js"></script>
    <link rel='stylesheet' href='/stylesheets/app.css' />
  </head>
  <body>
  <div class="bar">
      <img id="left" src="/images/flags/flag-4x3.png" alt="Flag of the Crushian Empire">
      <h1 id="middle"><%= title %></h1>
      <a id="right" href="/app"><%= righttext %></a>
  </div>
  <div class="container">
      <div class="screen">
          <h1>Welcome to the Crushian Empire</h1>
          <div class="inline-div">
              <p>The Crushian Empire is an empire on the popular Create mod server "Kryeit".</p>
              <img src="https://kryeitpa.pages.dev/image/minnem38_1077403410.dat" alt="Crushian Empire's HQ taken by me, minnem38">
          </div>
          <div class="inline-div">
              <p>We are located near the Leto post and we plan to make Leto better.</p>
              <img src="https://kryeitpa.pages.dev/image/minnem38_1096548547.dat" alt="Leto taken by me, minnem38">
          </div>
          <div class="inline-div">
              <p>We welcome everyone and believe everyone should be protected by Crushian Law.</p>
              <img src="https://kryeitpa.pages.dev/image/minnem38_1128111175.dat" alt="Leto Courthouse/government building taken by me, minnem38">
          </div>
      </div>
  </div>
  </body>
</html>
